{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon\\.jpg",
      "dest": "/favicon.jpg"
    },
    {
      "src": "/logo-share\\.jpg",
      "dest": "/logo-share.jpg"
    },
    {
      "src": "/logo-fundo-branco\\.png",
      "dest": "/logo-fundo-branco.png"
    },
    {
      "src": "/logo-transparente\\.png",
      "dest": "/logo-transparente.png"
    },
    {
      "src": "/icons\\.svg",
      "dest": "/icons.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
